# SQLite database location (relative to the prisma/ directory)
DATABASE_URL="file:./dev.db"

# Optional: enables AI-generated weekly check-ins via the Claude API.
# Without this key, the app falls back to a deterministic, rule-based summary.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# Optional: override the Claude model used for weekly check-ins.
# Defaults to claude-sonnet-4-6 (fast, strong reasoning for summaries).
ANTHROPIC_MODEL="claude-sonnet-4-6"
